{
  "name": "@amplifi-liquidity/amplifi-vaults-sdk",
  "version": "1.0.26",
  "description": "The Amplifi Vaults SDK",
  "main": "dist/src/index.cjs.js",
  "module": "dist/src/index.esm.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "yarn generate && rollup -c && tsc -d",
    "coverage": "jest --runInBand",
    "dev": "rollup -c -w",
    "format": "prettier --write \"src/**/*.ts\"",
    "generate": "node -e \"require('fs').rmSync('abis',{recursive:true,force:true})\" && typechain --target=ethers-v6 \"src/abis/**/*.json\" --out-dir \"abis/types\"",
    "lint:ts": "eslint --ext .js,.ts --ignore-path .gitignore .",
    "lint:fix": "eslint --ext .js,.ts --ignore-path .gitignore . --fix",
    "lint": "npm run lint:ts",
    "postversion": "git push && git push --tags",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "prepublishOnly": "yarn generate && npm test && npm run lint && yarn build",
    "preversion": "npm run lint",
    "test": "jest --runInBand --forceExit",
    "test:live": "LIVE_TESTS=1 jest --runInBand --forceExit",
    "version": "npm run format && git add -A src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amplifi-liquidity/amplifi-vaults-sdk.git"
  },
  "keywords": [
    "amplifi",
    "amplifi-vaults",
    "sdk"
  ],
  "author": "Amplifi Liquidity",
  "license": "MIT",
  "packageManager": "yarn@3.6.4",
  "bugs": {
    "url": "https://github.com/amplifi-liquidity/amplifi-vaults-sdk/issues"
  },
  "homepage": "https://github.com/amplifi-liquidity/amplifi-vaults-sdk#readme",
  "dependencies": {
    "@thanpolas/univ3prices": "^3.0.2",
    "@typechain/ethers-v6": "^0.5.1",
    "bignumber.js": "^9.0.1",
    "ethers": "^6.13.4",
    "global": "^4.4.0",
    "graphql": "^16.6.0",
    "graphql-request": "^6.0.0",
    "jsbi": "^3.1.5",
    "node-cache": "^5.1.2",
    "typechain": "^8.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.17.10",
    "@babel/preset-env": "^7.17.10",
    "@jest/globals": "^29.5.0",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^22.0.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-typescript": "^8.3.2",
    "@types/jest": "^27.5.0",
    "@types/node": "22.7.5",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "dotenv": "^16.0.1",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-config-prettier": "^6.3.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^3.1.0",
    "ethereum-protocol": "^1.0.1",
    "jest": "^29.1.0",
    "prettier": "^2.8.7",
    "rollup": "^2.72.1",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.1.0",
    "tslib": "^2.4.0",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^4.7.3",
    "web3-provider-engine": "^16.0.5"
  },
  "resolutions": {
    "ethereumjs-abi": "npm:0.6.8"
  }
}
